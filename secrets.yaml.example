# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# API encryption key — generate one with:  openssl rand -base64 32
# Use the same key in the Home Assistant ESPHome integration when adopting the device.
api_encryption_key: "REPLACE_WITH_openssl_rand_-base64_32"
